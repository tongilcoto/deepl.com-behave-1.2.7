@mcp.tool()
async def update_jira_ticket_status(jira_id: str, new_status: str) -> str:
    """Updates the Jira Ticket, both Test or Task, to the given new status.
    Args:
        - jira_id: jira id of the ticket.
        - new_status: the new status to be set in the ticket. Supported values are: "In Progress", "Code Review", "Resolved", "In Design"
    """
    if pw_context.api_context is None:
        return "Error: Not logged in. Please login first."
    if jira_id.startswith('@'):
        jira_id = jira_id.split('@')[1]
    text_string = await get_jira_ticket_available_transitions(jira_id)
    if text_string.startswith("Error"):
        return text_string
    transitions = json.loads(text_string)['transitions']
    transition = next((transition for transition in transitions if transition['name'] == new_status), None)
    data = {"transition": transition}
    base_url = f"/jira/rest/api/2/issue/{jira_id}"
    response = await pw_context.api_context.post(f"{base_url}/transitions",
        headers={ 'Content-Type': 'application/json' },
        data=json.dumps(data)
    )
    if response.status != 204:
        text = await response.text()
        return f"Error transitioning {jira_id}: {response.status} {text}"
    data = {"body": f"This issue has been updated to *{new_status}* status by the Jira-Xray MCP Server."}
    response = await pw_context.api_context.post(f"{base_url}/comment",
        headers={ 'Content-Type': 'application/json' },
        data=json.dumps(data)
    )
    if response.status != 201:
        text = await response.text()
        return f"Error adding comment to {jira_id}: {response.status} {text}"
    return f"{jira_id} updated with new status"


@mcp.tool()
async def download_feature_file(jira_id: str, project_root_folder: str) -> str:
    """Downloads the feature file for the given jira_id and places it in the 'features' folder of the project root folder.
    Args:
        - jira_id: the Jira issue id for the Test Set. Both options, with or without the initial '@' symbol, are supported.
        - project_root_folder: the project root folder where the "features" folder is. The file will be saved in "features" folder.
    """
    if pw_context.api_context is None:
        return "Error: Not logged in. Please login first."
    if jira_id.startswith('@'):
        jira_id = jira_id.split('@')[1]
    url = f"/jira/rest/raven/1.0/export/test?keys={jira_id}"
    response = await pw_context.api_context.get(url)
    if response.status != 200:
        return f"Error downloading {jira_id} feature file: {response.status}"
    sys.stderr.write(f'Headers: {response.headers}\n')
    content = await response.body()
    file_path = os.path.join(project_root_folder, "features", jira_id)
    text = content.decode('utf-8')
    text = '\n'.join(line.rstrip() for line in text.splitlines())
    with open(file_path, 'w', encoding='utf-8', newline='\n') as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    return f"{jira_id} feature file in 'features' folder"


def filter_behave_skipped_tests(report: list) -> list:
    for feature in report:
        feature['elements'] = [
            scenario for scenario in feature.get('elements', [])
            if any('result' in step for step in scenario.get('steps', []))
        ]
    return report


async def link_execution_to_test_set(test_execution: str, test_set: str) -> str | None:
    from jira_issue_link import JiraIssueLink

    jira_issue_link = JiraIssueLink(test_execution, test_set)
    data = jira_issue_link.PAYLOAD
    response = await pw_context.api_context.post('/jira/rest/api/2/issueLink',
        headers={ 'Content-Type': 'application/json' },
        data=json.dumps(data)
    )
    if response.status != 201:
        return f"Error linking {test_execution} to {test_set}: {response.status} {await response.text()}"
    return "OK"

@mcp.tool()
async def upload_bdd_report_file_to_jira(absolut_path_report_file_name: str, bdd_library: str, summary: str, test_set: str) -> str:
    """Downloads the feature file for the given jira_id and places it in the 'features' folder of the project root folder.
    Args:
        - absolut_path_report_file_name: the absolute path, included the file name, of the report file to be uploaded.
        - bbd_library: the BDD library used to generate the report file. Supported values are: "behave" and "cucumber"
        - summary: the summary of the test execution to be created in Jira Xray. (It is the jira ticket title)
        - test_set: the Jira issue id for the Test Set to link the created test execution. Both options, with or without the initial '@' symbol, are supported.
    """
    from jira_test_execution import JiraTestExecution
    sys.stderr.write('LOG TRACE upload_bdd_report_file_to_jira\n')

    if pw_context.api_context is None:
        return "Error: Not logged in. Please login first."
    if not os.path.exists(absolut_path_report_file_name):
        return f"Report file {absolut_path_report_file_name} does not exist."
    with open(absolut_path_report_file_name, 'rb') as f:
        result_buffer = f.read()
    if bdd_library.lower() == 'behave':
        result_buffer = json.dumps(filter_behave_skipped_tests(json.loads(result_buffer))).encode('utf-8')
    jira_test_execution = JiraTestExecution(summary)
    info_buffer = json.dumps(jira_test_execution.PAYLOAD).encode('utf-8')
    sys.stderr.write(f'LOG TRACE {info_buffer}')
    multipart = {
        "info": {
            "name": "info.json",
            "mimeType": "application/json",
            "buffer": info_buffer
        },
        "result": {
            "name": "result.json",
            "mimeType": "application/json",
            "buffer": result_buffer
        }
    }
    sys.stderr.write('LOG TRACE before post\n')
    response = await pw_context.api_context.post(f'/jira/rest/raven/1.0/import/execution/{bdd_library}/multipart',
        multipart=multipart,  # type: ignore
        timeout=120_000 )
    if response.status != 200:
        return f"Error uploading {absolut_path_report_file_name} report: {response.status} {await response.text()}"
    test_execution_id = (await response.json())['testExecIssue']['key']
    # Link the created test execution to the given test set
    sys.stderr.write('LOG TRACE before issue link\n')
    is_linked = await link_execution_to_test_set(test_execution_id, test_set)
    if is_linked.startswith("Error"):
        return is_linked
    return f"{test_execution_id} Test execution created and linked to {test_set}"


def basic_prompt(feature_file: str) -> str:
    return f"""Your role is to update the scenarios of a set of tests. 
The tests are located in a 'Jira Server' instance. This Jira Server has a *test management* plugin called Xray.
Xray adds several types of Issue Types to regular Jira Server configuration. One of them is Test. 
Xray allows native managing of Gherkin scenarios, both Scenario and Scenario Outline. Every Test issue has a custom field that hosts the Gherkin scenario. 
That custom field is what you have to update following these instructions
1. Locate the tests that have changed in {feature_file}
2. Extract only the Gherkin steps, not the tags line, not the Scenario name, following these examples:

2.1. Example 1: Changed Scenario test "TEST_SDPC-5" (notice that is the first tag of the tags line but without the '@' char) 
2.1.1. Final Version:
	@TEST_SDPC-5 @TESTSET_SDPC-99 @TESTSET_SDPC-105 @TESTSET_SDPC-106 @LeftMenu @Products @page
	Scenario: Reset App State left menu option in Products page resets Shopping Cart and products status
		Given I select "Add To Cart" option for "1" "unselected" random products when logged as "standard_user" user
		And I select "Menu" option at "Products" page
		When I select "Reset App State" option at the left menu
		Then I don't see any badge in shopping cart at "Products" page
		And I see product option is "Add To Cart" for "all" products at "Products" page
2.1.2. Extracted Gherkin steps (notice there is no blank/tab on the left margin):
Given I select "Add To Cart" option for "1" "unselected" random products when logged as "standard_user" user
And I select "Menu" option at "Products" page
When I select "Reset App State" option at the left menu
Then I don't see any badge in shopping cart at "Products" page
And I see product option is "Add To Cart" for "all" products at "Products" page

2.2. Example 2: Changed Scenario Outline test "TEST_SDPC-4" (notice that is the first tag of the tags line but without the '@' char)
2.2.1. Final Version:
        @TEST_SDPC-4 @TESTSET_SDPC-98 @TESTSET_SDPC-106 @Login @page
    	Scenario Outline: Invalid Login when using valid user and locked user and invalid password throws a login error
    		Given I am "<user>" user
    		When I login with user "invalid" password
    		Then I see "Login" error at Login page

    		Examples:
    			| user            |
    			| standard_user   |
				| locked_out_user |

2.2.2. Extracted Gherkin steps (notice there is no blank/tab on the left margin):
Given I am "<user>" user
When I login with user "invalid" password
Then I see "Login" error at Login page

Examples:
    | user            |
	| standard_user   |
    | locked_out_user |

3. Once you have all the changed tests and the final version of gherkin steps you can proceed to update Jira Server Instance
3.1. Login into my Jira Server using the provided tool
3.2. Create a loop: For every changed test, update it using the provided tool
"""

@mcp.prompt()
def update_xray_scenarios(feature_file: str) -> str:
    """Instructions for updating the modified tests in the given feature file (the name, not the content)
    Args:
        feature_file: the name of the feature file that contains the modified tests
    """
    return f"""{basic_prompt(feature_file)}
3.3. Logout
"""

@mcp.prompt()
def update_xray_scenarios_and_download_new_feature_file(feature_file: str, folder: str, jira_id: str) -> str:
    """Instructions for updating the modified tests in the given feature file (the name, not the content) and
    then download the feature file for the given test set and placed in the given folder
    Args:
        - feature_file: the name of the feature file that contains the modified tests.
        - project_root_folder: the project root folder where the "features" folder is. The file will be saved in "features" folder.
        - jira_id: the Jira issue id for the Test Set. Both options, with or without the initial '@' symbol, are supported.
    """
    if jira_id.startswith('@'):
        jira_id = jira_id.split('@')[1]
    return f"""{basic_prompt(feature_file)}
3.3. Ask Xray to create and download the feature file into the {folder} folder for the {jira_id} test set
3.4. Logout
"""

