class PlaywrightContext:
    def __init__(self):
        self.engine = None  # Playwright
        self.browser: Browser | None = None
        self.api_context: APIRequestContext | None = None

    async def start(self):
        self.engine = await async_playwright().start()

    async def login_into_jira_server(self):
        if os.getenv(os.getenv('CI_CD_ENV_VARIABLE')):
            proxy_options =  browser_proxy_options if os.getenv('CI_CD_NEEDS_PROXY') else None
            browser = await self.engine.chromium.launch(headless=False, slow_mo=100, proxy=proxy_options)
            username = os.getenv('CI_CD_JIRA_USERNAME')
            password = os.getenv('CI_CD_JIRA_PASSWORD')
            config['JIRA_USER_KEY'] = os.getenv('CI_CD_JIRA_USER_KEY')
            os.environ['JIRA_USER_KEY'] = os.getenv('CI_CD_JIRA_USER_KEY')
            config['JIRA_USER_NAME'] = os.getenv('CI_CD_JIRA_USER_NAME')
            os.environ['JIRA_USER_NAME'] = os.getenv('CI_CD_JIRA_USER_NAME')
        else:
            proxy_options =  browser_proxy_options if os.getenv('LOCAL_NEEDS_PROXY') else None
            browser = await self.engine.chromium.launch(headless=False, slow_mo=100, proxy=proxy_options)
            username = os.getenv('LOCAL_JIRA_USERNAME')
            password = os.getenv('LOCAL_JIRA_PASSWORD')
            config['JIRA_USER_KEY'] = os.getenv('LOCAL_JIRA_USER_KEY')
            os.environ['JIRA_USER_KEY'] = os.getenv('LOCAL_JIRA_USER_KEY')
            config['JIRA_USER_NAME'] = os.getenv('LOCAL_JIRA_USER_NAME')
            os.environ['JIRA_USER_NAME'] = os.getenv('LOCAL_JIRA_USER_NAME')

        context = await browser.new_context()
        page = await context.new_page()
        await page.goto('https://jira.axa.com/')
        await page.fill('#identifierInput', username)
        await page.click('#postButton button')
        await page.wait_for_selector('#password')
        await page.fill('#password', password)
        await page.click('#signOnButton')
        await page.wait_for_selector('#logo')

        cookies = await context.cookies()

        login_cookie = next((c['value'] for c in cookies if c['name'] == os.getenv("LOGIN_COOKIE")), None)
        if not login_cookie:
            await browser.close()
            return f"Login has failed. Login cookie not found!"

        self.browser = browser

        self.api_context = await self.engine.request.new_context(
            base_url="https://jira.axa.com",
            ignore_https_errors=True,
            storage_state={"cookies": cookies, "origins": []},
        )
        return "Logged"

    async def logout(self):
        if self.api_context is not None:
            await self.api_context.dispose()
            self.api_context = None
        if self.browser is not None:
            await self.browser.close()
            self.browser = None
        if self.engine is not None:
            await self.engine.stop()
            self.engine = None
        return "Logged out"

