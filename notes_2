@mcp.tool()
async def update_jira_test_scenario(jira_id: str, new_scenario: str) -> str:
    """Updates the Scenario of the Test in Jira. The Test is an issue type provided by Xray
    Args:
        - jira_id: jira id of the test issue type. Both options, with or without the initial '@' symbol, are supported
        - new_scenario: the new scenario text writen in Gherkin to be set in the Test issue type.
    """
    if pw_context.api_context is None:
        return "Error: Not logged in. Please login first."
    if jira_id.startswith('@'):
        jira_id = jira_id.split('@')[1]
    url = f"/jira/rest/api/2/issue/{jira_id}"
    data = {
        "fields": {
            config["JIRA_GHERKIN_FIELD"]: new_scenario,
        }
    }
    response = await pw_context.api_context.put(url,
        headers={ 'Content-Type': 'application/json' },
        data=json.dumps(data)
    )
    if response.status != 204:
        text = await response.text()
        return f"Error updating {jira_id} test scenario: {response.status} {text}"
    data = {"body": "Test Scenario updated (comment added by the Jira-Xray MCP Server.)"}
    response = await pw_context.api_context.post(f"{url}/comment",
        headers={ 'Content-Type': 'application/json' },
        data=json.dumps(data)
    )
    if response.status != 201:
        text = await response.text()
        return f"Error adding comment to {jira_id} test: {response.status} {text}"
    return f"{jira_id} updated with new scenario"


