@mcp.tool()
async def create_jira_test(name: str, scenario: str, labels: str) -> str:
    """Creates a brand new Test in Jira. The Test is an issue type provided by Xray
    Args:
        - name: the name of the Test to be created, the scenario name in a BDD framework.
        - scenario: the new scenario text writen in Gherkin to be set in the Test issue type.
        - labels: the labels to be set in the Test issue type, separated by commas: "tag1,tag2,tag3" (no spaces)
    """
    from jira_test import JiraTest

    if pw_context.api_context is None:
        return "Error: Not logged in. Please login first."
    url = f"/jira/rest/api/2/issue/"
    # Removing initial '@' symbol if present in tags
    labels = [tag.split('@')[1] if tag.startswith('@') else tag for tag in labels.split(',')]
    jira_test = JiraTest(name, scenario, labels)
    data = jira_test.PAYLOAD
    response = await pw_context.api_context.post(url,
        headers={ 'Content-Type': 'application/json' },
        data=json.dumps(data)
    )
    if response.status != 201:
        text = await response.text()
        return f"Error creating new test: {response.status} {text}"
    new_test = await response.json()
    data = {"body": "This test has been created by the Jira-Xray MCP Server."}
    response = await pw_context.api_context.post(f"{url}/{new_test['key']}/comment",
        headers={ 'Content-Type': 'application/json' },
        data=json.dumps(data)
    )
    if response.status != 201:
        text = await response.text()
        return f"Error adding comment to {new_test['key']} test: {response.status} {text}"
    return f"{new_test['key']} CREATED with new scenario"


